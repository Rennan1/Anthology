{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "port": {
          "default": 8080,
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bodyLimit": {
          "default": "10mb",
          "type": "string",
          "minLength": 1
        },
        "shutdownGraceMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "default": {},
      "type": "object",
      "properties": {
        "level": {
          "default": "info",
          "type": "string",
          "enum": ["fatal", "error", "warn", "info", "debug", "trace"]
        },
        "includeContent": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "keyEnv": {
                "type": "string",
                "minLength": 1
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "keyEnv", "routes"],
            "additionalProperties": false
          }
        }
      },
      "required": ["keys"],
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "apiKeyEnv": {
            "type": "string",
            "minLength": 1
          },
          "baseURL": {
            "type": "string",
            "format": "uri"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["type", "apiKeyEnv"],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["tools", "vision", "json_schema"]
            }
          },
          "contextWindow": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxOutputTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "timeoutMs": {
            "default": 120000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxRetries": {
            "default": 1,
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "defaults": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "topP": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "presencePenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "frequencyPenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "stop": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "providerOptions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["provider", "modelId", "capabilities"],
        "additionalProperties": false
      }
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "fallbacks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultRoute": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "default": 5000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "instructions": {
          "type": "string",
          "maxLength": 2000
        },
        "context": {
          "default": {},
          "type": "object",
          "properties": {
            "maxMessages": {
              "default": 6,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxCharsPerMessage": {
              "default": 2000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxChars": {
              "default": 8000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["model", "defaultRoute"],
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "fallbacks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaults": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "topP": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "presencePenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "frequencyPenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "stop": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "enforce": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "topP": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "presencePenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "frequencyPenalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "stop": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["description", "target"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "auth", "providers", "models", "orchestrator", "routes"],
  "additionalProperties": false
}
